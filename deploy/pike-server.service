[Unit]
Description=Pike Tunnel Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pike
Group=pike
WorkingDirectory=/opt/pike
Environment="RUST_LOG=info"
Environment="RUST_BACKTRACE=1"
# Optional error monitoring (fix #6). Leave unset to disable Sentry entirely (no-op).
# Uncomment and set your DSN to enable panic + error-event reporting:
# Environment="SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>"
ExecStart=/opt/pike/pike-server --config /etc/pike/server.toml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Logging
# Send stdout/stderr to the systemd journal instead of an ever-growing flat
# file. Journald enforces retention/size caps (see the shipped
# pike-server.service.d/journald.conf drop-in) so logs cannot fill the disk.
# View with: journalctl -u pike-server -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pike-server

# Security hardening
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pike /var/lib/pike /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
